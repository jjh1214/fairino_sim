<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fairino_sim</name>
  <version>0.0.0</version>
  <description>Gazebo Harmonic and MoveIt 2 simulation of FAIRINO cobots</description>
  <maintainer email="scarlet777735@gmail.com">axbis-jhjung</maintainer>
  <license>MIT</license>

  <!-- Robot models from FAIR-INNOVATION/frcobot_ros2 -->
  <exec_depend>fairino_description</exec_depend>
  <exec_depend>fairino3_v6_moveit2_config</exec_depend>
  <exec_depend>fairino5_v6_moveit2_config</exec_depend>
  <exec_depend>fairino10_v6_moveit2_config</exec_depend>
  <exec_depend>fairino16_v6_moveit2_config</exec_depend>
  <exec_depend>fairino20_v6_moveit2_config</exec_depend>
  <exec_depend>fairino30_v6_moveit2_config</exec_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_planners</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
