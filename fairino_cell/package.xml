<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fairino_cell</name>
  <version>0.0.0</version>
  <description>Work cell tools for fairino_sim: CAD import, cell scene management, recipe execution and path validation</description>
  <maintainer email="scarlet777735@gmail.com">axbis-jhjung</maintainer>
  <license>MIT</license>

  <exec_depend>fairino_cell_msgs</exec_depend>
  <exec_depend>fairino_sim</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
