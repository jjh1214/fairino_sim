# Move the robot after checking the whole path for collisions, joint limits and clearance:
# PTP (straight line in joint space, like MoveJ), LIN (straight TCP line, like MoveL) or
# CIRC (TCP arc through a via point, like MoveC).
uint8 JOINTS=0
uint8 POSE=1
uint8 PTP=0
uint8 LIN=1
uint8 CIRC=2
uint8 target_type
uint8 motion                       # PTP (default), LIN or CIRC
float64[] joints                   # JOINTS: j1..j6 [rad]
geometry_msgs/PoseStamped pose     # POSE: TCP pose; header.frame_id is world, an object or
                                   # an object frame such as part/grasp
geometry_msgs/PoseStamped via      # CIRC: a point of the arc (its orientation is not used)
float64 speed                      # (0..1]; 0 = default. PTP: fraction of the joint velocity
                                   # and acceleration limits; LIN, CIRC: of the TCP speed limits
string[] allowed_contacts          # objects the tool and the held object may touch in this move
bool check_only                    # check in the check session only; do not move the robot
string name                        # step name for the report
---
bool success
StepReport report
---
string phase                       # target, check or execute
float32 progress                   # 0..1 while executing
